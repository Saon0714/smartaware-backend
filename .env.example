# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DEBUG=true

# --- Database (Postgres 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://smartaware:smartaware@localhost:5432/smartaware

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS: explicit allowlist, comma-separated. Never "*". ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Leave COOKIE_DOMAIN unset locally. In production: .smartaware.com
# COOKIE_DOMAIN=.smartaware.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

FRONTEND_BASE_URL=http://localhost:3000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AWS ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=smartaware-documents-local
SES_SENDER_EMAIL=no-reply@smartaware.example
USE_LOCAL_STORAGE=true
USE_CONSOLE_EMAIL=true

# --- Wise (Section 12) ---
# The Open Payment Link copied from the Wise Business dashboard.
# There is no Wise API key: creating links via the API is unsupported.
WISE_PAYMENT_LINK_BASE_URL=https://wise.com/pay/business/smartaware
